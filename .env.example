# 本機測試用。複製成 .env 並填入實際值（.env 已在 .gitignore 中）

# LLM 供應商：github（預設）或 gemini
LLM_PROVIDER=github

# LLM_PROVIDER=github 時需要。
# 在 Actions 裡會自動注入 runner token，不必自己設；
# 本機測試請到 GitHub Settings → Developer settings → Personal access tokens
# 建一個 fine-grained token，勾選 Models: read。
GITHUB_TOKEN=github_pat_...

# LLM_PROVIDER=gemini 時需要（https://aistudio.google.com/apikey）
# GEMINI_API_KEY=AIza...

# Discord 頻道 → 編輯頻道 → 整合 → Webhook → 建立 Webhook → 複製網址
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
